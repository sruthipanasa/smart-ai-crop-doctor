# GEMINI_API_KEY: Required for Gemini AI crop doctor recommendations and farmer chatbot.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HUGGINGFACE_API_KEY: Optional free inference API token from Hugging Face for plant disease vision classification.
# If not provided, the system uses built-in smart agricultural vision heuristics and sample models.
HUGGINGFACE_API_KEY=""

# OPENWEATHER_API_KEY: Optional free API key from OpenWeatherMap for live weather advisories.
# If not provided, realistic agricultural microclimate forecasts are provided for any searched city/region.
OPENWEATHER_API_KEY=""

# MySQL Database Configuration
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="smart_ai_crop_doctor"

# JWT Secret for User Authentication
JWT_SECRET="your_jwt_secret_key_change_in_production"

